# npm run demo needs no secrets and uses memory-only sample data.
# Production requires explicit settings; use Secret Manager on GCP.
APP_MODE=production
NEXT_PUBLIC_APP_MODE=production
APP_ORIGIN=https://nft.vgr.cx
MARKETING_ORIGIN=https://nft.vgr.cx
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/nftech
NEXT_PUBLIC_PRIVY_APP_ID=cmugv9qec007k0cjqls8jvrw2
PRIVY_APP_ID=cmugv9qec007k0cjqls8jvrw2
PRIVY_APP_SECRET=
KMS_KEY_RESOURCE=
CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_RECIPIENT=
PAYMENT_RPC_URL=https://evmrpc.0g.ai
PAYMENT_CONFIRMATIONS=12
# Merchant route is deliberately unconfigured until source/order/destination proof is verified.
ENS_ENABLED=false
ENS_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ENS_SEPOLIA_RPC_URL=
ENS_WRITE_ENABLED=false
ENROLLMENT_OPEN=true
MEMBER_DIRECTORY_ENABLED=true
NOW_ENABLED=true
SUPPORT_EMAIL=
SELLER_NAME=
# Set only behind a proxy that overwrites incoming client-provided IP headers.
TRUST_PROXY=false

# GCP: a JSON map of allowed server env names to Secret Manager version resources.
# Runtime access uses the attached service account; never commit secret values.
SECRET_ENV_MAP=

# ENSv2 trips, tables and concierge (Sepolia beta). Run npm run ens:bootstrap once to fill the addresses.
ENS_PARENT_NAME=
ENS_PARENT_REGISTRY=
ENS_CITY_REGISTRY_TOKYO=
ENS_APP_RESOLVER=
# Two different keys: the operator registers names and writes member records, the concierge holds
# setter roles for friendship.now and friendship.table only. Secret Manager in production.
ENS_OPERATOR_PRIVATE_KEY=
ENS_CONCIERGE_PRIVATE_KEY=
# World ID (IDKit v4) at trip activation. Developer Portal: app id, RP id, RP signing key.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION_TRIP=trip-activate
# staging with the simulator during development, production for real proofs.
WORLD_ENVIRONMENT=staging
# World ID for Agents sandbox (OIDC). Register the client at https://sandbox.auth.world.org/portal.
# The redirect URI must be a public HTTPS URL ending in /api/world/agent/callback.
WORLD_AGENTS_ISSUER=https://sandbox.auth.world.org
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_CLIENT_SECRET=
WORLD_AGENTS_REDIRECT_URI=
# rules (deterministic, shipped) or custom (src/server/ens-world/concierge/custom-brain.ts).
CONCIERGE_BRAIN=rules
# Mount 0G Pay for peer-to-peer split payments instead of a plain USDC transfer.
SPLIT_OGPAY_ENABLED=false
