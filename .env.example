# npm run demo needs no secrets and uses memory-only sample data.
# Production requires explicit settings; use Secret Manager on GCP.
APP_MODE=production
NEXT_PUBLIC_APP_MODE=production
APP_ORIGIN=https://app.example.com
MARKETING_ORIGIN=https://example.com
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/nftech
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
KMS_KEY_RESOURCE=
CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_RECIPIENT=
PAYMENT_RPC_URL=https://evmrpc.0g.ai
PAYMENT_CONFIRMATIONS=12
# Merchant route is deliberately unconfigured until source/order/destination proof is verified.
ENS_ENABLED=false
ENS_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ENS_SEPOLIA_RPC_URL=
ENS_WRITE_ENABLED=false
ENROLLMENT_OPEN=true
MEMBER_DIRECTORY_ENABLED=true
NOW_ENABLED=true
SUPPORT_EMAIL=
SELLER_NAME=
# Set only behind a proxy that overwrites incoming client-provided IP headers.
TRUST_PROXY=false
